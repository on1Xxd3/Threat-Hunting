## Цель работы

1. Закрепить навыки анализа журналов Windows Active Directory.
2. Разобрать структуру событий и полей AD-лога.
3. Отработать практику обработки данных на R.
4. Закрепить применение ключевых инструментов tidyverse для очистки и анализа логов.

## Исходные данные

1. ОС Windows 11.
2. Среда разработки RStudio.
3. Интерпретатор R версии 4.5.1.

## План

1. Загрузить датасет в R (архив доступен по адресу  
   https://storage.yandexcloud.net/iamcth-data/dataset.tar.gz).
2. Привести данные к “аккуратному” виду и назначить корректные типы столбцов.
3. Просмотреть структуру таблицы через `glimpse()`.
4. Раскрыть вложенные структуры (list-колонки) в плоский датафрейм.
5. Удалить колонки с единственным уникальным значением.
6. Определить число уникальных хостов в наборе.
7. Сформировать справочник расшифровки Event_ID и привести типы к смысловым.
8. Проверить наличие событий высокой и средней критичности и посчитать их.

## Шаги

### Загрузка библиотек

```{r}
options(repos = c(CRAN = "https://mirror.truenetwork.ru/CRAN/"))

needed_pkgs <- c("jsonlite", "dplyr", "tidyr", "xml2", "rvest")
for (pkg in needed_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
}

library(jsonlite)
library(dplyr)
library(tidyr)
library(xml2)
library(rvest)
```

```{r}
###Импорт данных в R
### Импорт данных в R (dataset.tar.gz -> *.json -> stream_in)

# Если jsonlite не установлен — раскомментируй:
# install.packages("jsonlite")

library(jsonlite)

data_url <- "https://storage.yandexcloud.net/iamcth-data/dataset.tar.gz"
archive_path <- "dataset.tar.gz"

# 1) Скачиваем архив, если его нет локально
if (!file.exists(archive_path)) {
  download.file(url = data_url, destfile = archive_path, mode = "wb")
}

# 2) Смотрим список файлов внутри архива
files_in_archive <- untar(tarfile = archive_path, list = TRUE)

# 3) Находим JSON-файлы внутри (вариант через endsWith — без regex)
json_inside <- files_in_archive[endsWith(files_in_archive, ".json")]

# Проверка: если JSON не найден — падаем с понятной ошибкой
if (length(json_inside) == 0) {
  stop("В архиве не найдено ни одного .json файла. Проверь содержимое archive_path.")
}

# Если JSON несколько — можно взять первый или выбрать конкретный
# Здесь берем первый:
json_inside <- json_inside[1]

# 4) Распаковываем найденный JSON во временную папку
tmp_dir <- tempdir()
untar(tarfile = archive_path, files = json_inside, exdir = tmp_dir)

json_path <- file.path(tmp_dir, json_inside)

# 5) Читаем потоково (чтобы не падать по памяти)
con_json <- file(json_path, open = "r", encoding = "UTF-8")
log_raw <- stream_in(con_json, verbose = FALSE)
close(con_json)

# 6) (Опционально) Быстрые проверки результата
cat("JSON файл:", json_inside, "\n")
cat("Путь:", json_path, "\n")
cat("Тип:", class(log_raw), "\n")
if (is.data.frame(log_raw)) cat("Размер:", nrow(log_raw), "x", ncol(log_raw), "\n")
if (is.list(log_raw) && !is.data.frame(log_raw)) cat("Длина списка:", length(log_raw), "\n")

# Теперь log_raw — объект с данными

```

```{r}

###Приведение типов и “аккуратные данные”
# ---- вспомогательные детекторы типов ----

looks_like_datetime <- function(col) {
if (is.character(col) || is.factor(col)) {
sample_vals <- as.character(col)
sample_vals <- sample_vals[!is.na(sample_vals)]
if (length(sample_vals) == 0) return(FALSE)
probe <- try(as.POSIXct(sample_vals[1]), silent = TRUE)
return(inherits(probe, "POSIXct"))
}
FALSE
}

looks_like_number <- function(col) {
if (is.character(col) || is.factor(col)) {
x <- as.character(col)
x <- x[!is.na(x)]
suppressWarnings(all(!is.na(as.numeric(x))))
} else {
FALSE
}
}

looks_like_logical <- function(col) {
if (is.character(col) || is.factor(col)) {
x <- tolower(as.character(col))
uniq <- unique(x[!is.na(x)])
allowed <- c("true", "false", "1", "0")
ok <- length(uniq) > 0 && all(uniq %in% allowed)
has_tf <- any(uniq == "true") && any(uniq == "false")
has_10 <- any(uniq == "1") && any(uniq == "0")
ok && (has_tf || has_10)
} else {
FALSE
}
}

# ---- datetime ----

dt_cols <- names(log_raw)[sapply(log_raw, looks_like_datetime)]
if (length(dt_cols) > 0) {
for (nm in dt_cols) {
log_raw[[nm]] <- tryCatch(as.POSIXct(log_raw[[nm]]), error = function(e) log_raw[[nm]])
}
}

# ---- numeric ----

num_cols <- names(log_raw)[sapply(log_raw, looks_like_number)]
if (length(num_cols) > 0) {
log_raw <- log_raw %>% mutate(across(all_of(num_cols), ~as.numeric(as.character(.x))))
}

# ---- logical ----

bool_cols <- names(log_raw)[sapply(log_raw, looks_like_logical)]
if (length(bool_cols) > 0) {
for (nm in bool_cols) {
v <- tolower(as.character(log_raw[[nm]]))
log_raw[[nm]] <- ifelse(v %in% c("true", "1"), TRUE,
ifelse(v %in% c("false", "0"), FALSE, NA))
}
}
```

```{r}

###Просмотр структуры данных
glimpse(log_raw)
```

```{r}

### Раскрытие вложенных датафреймов (unnest)
# ищем list-колонки и разворачиваем их до плоского вида

list_cols <- names(log_raw)[sapply(log_raw, is.list)]

log_flat <- log_raw %>%
unnest(cols = all_of(list_cols), names_sep = "_", keep_empty = TRUE)

# если после первого прохода list-колонки остались — докручиваем циклом

left_lists <- names(log_flat)[sapply(log_flat, is.list)]
iter <- 0
while (length(left_lists) > 0 && iter < 10) {
log_flat <- log_flat %>%
unnest(cols = all_of(left_lists), names_sep = "_", keep_empty = TRUE)
left_lists <- names(log_flat)[sapply(log_flat, is.list)]
iter <- iter + 1
}
```

```{r}
### Удаление константных колонок
is_constant <- function(col) {
u <- unique(col)
u <- u[!is.na(u)]
length(u) <= 1
}

const_names <- names(log_flat)[sapply(log_flat, is_constant)]

log_min <- log_flat %>%
select(-all_of(const_names))

glimpse(log_min)
```

```{r}
### Количество хостов в датасете
src_host_field <- "winlog_event_data_SourceHostname"
hosts_total <- n_distinct(log_min[[src_host_field]])
hosts_total
```

```{r}
### Справочник расшифровки Event_ID
ms_doc_url <- "https://learn.microsoft.com/en-us/windows-server/identity/ad-ds/plan/appendix-l--events-to-monitor"
ms_page <- read_html(ms_doc_url)

event_ref_raw <- html_table(ms_page)[[1]]

event_ref <- event_ref_raw %>%
mutate(
`Current Windows Event ID` = as.numeric(`Current Windows Event ID`),
`Legacy Windows Event ID`  = as.numeric(`Legacy Windows Event ID`),
`Potential criticality`    = as.character(`Potential Criticality`),
`Event Summary`            = as.character(`Event Summary`)
)

head(event_ref, 10)
```

```{r}
### События высокой и средней критичности
crit_joined <- log_min %>%
select(event_code) %>%
left_join(
event_ref %>% select(`Current Windows Event ID`, `Potential Criticality`),
by = join_by(event_code == `Current Windows Event ID`)
)

is_high <- ifelse(
is.na(crit_joined$`Potential Criticality`),
FALSE,
grepl("High", crit_joined$`Potential Criticality`, ignore.case = TRUE)
)

is_medium <- ifelse(
is.na(crit_joined$`Potential Criticality`),
FALSE,
grepl("Medium", crit_joined$`Potential Criticality`, ignore.case = TRUE)
)

high_cnt <- sum(is_high)
cat("Событий Hight: ", high_cnt, "\n")

medium_cnt <- sum(is_medium)
cat("Событий Medium: ", medium_cnt)
```


###Оценка результата

В ходе практической работы была проанализирована выгрузка из SIEM-системы внутренней сети «Доброй Организации» на предмет признаков компрометации. Данные были очищены, приведены к корректным типам, развернуты в плоскую структуру и сокращены за счёт удаления неинформативных колонок. Получены ответы на поставленные вопросы, включая подсчёт уникальных хостов и выявление событий повышенной критичности.

###Вывод

Таким образом, работа закрепила навыки обработки и анализа журналов Windows Active Directory в R. Были отработаны приёмы приведения данных к tidy-формату, использования функций tidyverse и сопоставления событий с внешним справочником Event_ID, что позволило оценить структуру активности в домене и наличие потенциально значимых инцидентов.

